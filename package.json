{
  "name": "poker-web",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s typecheck build-only",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run test:browser",
    "build-only": "vite build",
    "type-check": "npm run typecheck",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --max-warnings=0",
    "format": "eslint . --fix && prettier --write --no-error-on-unmatched-pattern \"*.{json,md,html}\" \"docs/**/*.md\" \"src/**/*.css\" \"e2e/*.json\"",
    "typecheck": "vue-tsc --build && tsc --project e2e/tsconfig.json --noEmit",
    "format:check": "eslint . --max-warnings=0 && prettier --check --no-error-on-unmatched-pattern \"*.{json,md,html}\" \"docs/**/*.md\" \"src/**/*.css\" \"e2e/*.json\"",
    "prebuild-only": "node tools/install-game.mjs",
    "test:browser": "playwright test",
    "test": "run-s test:unit test:browser",
    "format-check": "npm run format:check"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.71.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "imports": {
    "#game-artifact": "./game-artifact.lock.json"
  },
  "license": "MIT"
}
